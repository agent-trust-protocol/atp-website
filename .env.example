# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase/Postgres connection used by Better Auth and app tables.
# Use the Supabase Postgres connection string, not Supabase Auth email settings.
DATABASE_URL=

# App-owned email delivery. Resend is not automatically enabled by Supabase.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@agenttrustprotocol.com
EMAIL_FROM_NAME=Agent Trust Protocol
ADMIN_EMAIL=

