# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase/Postgres connection used by Better Auth and app tables.
# Use the Supabase Postgres connection string, not Supabase Auth email settings.
DATABASE_URL=

# App-owned email delivery. Resend is not automatically enabled by Supabase.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@agenttrustprotocol.com
EMAIL_FROM_NAME=Agent Trust Protocol
ADMIN_EMAIL=

# Founder bootstrap (one-time setup of the founder account via /api/admin/setup).
# Leave unset in environments where you don't want that endpoint to function.
FOUNDER_EMAIL=
FOUNDER_SETUP_TOKEN=

# Bearer token required by privileged admin endpoints (e.g. /api/approve-access).
ADMIN_API_SECRET=

# ATP backend service URLs. Used by dashboard widgets to talk to the live
# services. If unset, the widget renders an "unconfigured" state instead of
# silently pointing the browser at localhost.
# Client-side (NEXT_PUBLIC_*) URLs are visible in the browser bundle.
NEXT_PUBLIC_ATP_IDENTITY_URL=
NEXT_PUBLIC_ATP_PERMISSION_URL=
NEXT_PUBLIC_ATP_AUDIT_URL=
# Server-only:
ATP_MONITORING_URL=
ATP_AUDIT_URL=

# Onboarding execution-log link target. If unset, the link is hidden.
NEXT_PUBLIC_ONBOARD_EXECUTION_URL=
